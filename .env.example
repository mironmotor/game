# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
NEXT_PUBLIC_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Auth.js / Google OAuth (server-side only).
# Production callback: https://game-ultra.vercel.app/api/auth/callback/google
# Generate AUTH_SECRET with: npm exec auth secret
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Neon Postgres pooled connection URL (server-side only).
# The Vercel Neon integration can inject this automatically.
# Format: postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DATABASE_URL=""

# MAX Voice provider (server-side only).
# Local development:
MAX17_TTS_URL="http://127.0.0.1:8017"
# Production must use a token-protected HTTPS tunnel or a private GPU service.
MAX17_TTS_TOKEN=""
MAX17_TTS_TIMEOUT_MS="25000"
MAX17_TTS_METADATA_TIMEOUT_MS="2500"
MAX17_VOICE_STREAM_INTERVAL="0.24"
MAX17_VOICE_ENGINE="auto"
MAX17_VOICE_MODEL="mlx-community/Qwen3-TTS-12Hz-0.6B-CustomVoice-8bit"
MAX17_VOICE_PRELOAD="1"
TTS_RATE_LIMIT_PER_MINUTE="30"

# ElevenLabs cloud fallback (server-side only).
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_JARVIS=""
ELEVENLABS_VOICE_FRIDAY=""
ELEVENLABS_TTS_TIMEOUT_MS="25000"
