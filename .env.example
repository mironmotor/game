# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
NEXT_PUBLIC_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Max17 remote bridge (for /autoplan and /maxgraph on Vercel) ──────────────
# On Vercel there is no python3, so /api/max17 proxies to a hosted mark17 bridge
# (mark17/server.py). Set these in the VERCEL project (Frontend env):
#   MAX17_BRIDGE_URL   = https://your-bridge.up.railway.app   (no trailing slash)
#   MAX17_BRIDGE_TOKEN = a-long-random-shared-secret          (optional but recommended)
# Leave MAX17_BRIDGE_URL unset locally — then `npm run dev` spawns python3 directly.
MAX17_BRIDGE_URL=""
MAX17_BRIDGE_TOKEN=""

# ── Set these on the BRIDGE service (Railway/Fly), not on Vercel ─────────────
# MAX17_BRIDGE_TOKEN   same secret as above (the bridge validates it)
# MAX17_LLM_ENABLED    "true" to let the core call an LLM (default: deterministic)
# MAX17_LLM_PROVIDER   "openrouter" (hosted) or "ollama" (local)
# OPENROUTER_API_KEY   your OpenRouter key when provider=openrouter
# MAX17_LLM_MODEL      optional model override (e.g. google/gemini-2.0-flash-exp:free)
# MAX17_STATE_DIR      persistent path for memory/synapses (Docker: /data/state)
