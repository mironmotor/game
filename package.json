{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:hud": "next dev -H 127.0.0.1 -p 3002 --experimental-https",
    "build": "next build",
    "start": "next start",
    "start:hud": "next start -H 127.0.0.1 -p 3002",
    "lint": "eslint .",
    "max17:smoke": "python3 mark17/smoke.py",
    "max17:intuition": "python3 mark17/intuition_smoke.py",
    "max17:dream": "python3 mark17/dream_smoke.py",
    "max17:env": "python3 mark17/env_smoke.py",
    "max17:parity": "python3 mark17/parity_check.py",
    "max17:serve": "python3 mark17/serve.py --no-llm",
    "max17:web": "python3 mark17/json_cli.py --no-llm --ephemeral < mark17/examples/max17-web-research.json",
    "max17:curiosity": "python3 mark17/json_cli.py --no-llm < mark17/examples/max17-autonomous-research.json",
    "max17:sleep": "python3 mark17/json_cli.py --no-llm --ephemeral --warmup mark17/examples/max17-recall-warmup.jsonl < mark17/examples/max17-sleep.json",
    "max17:working": "python3 mark17/working_smoke.py",
    "max17:plan": "python3 mark17/plan_smoke.py",
    "max17:outcome": "python3 mark17/outcome_smoke.py",
    "max17:sense": "python3 mark17/json_cli.py --no-llm --ephemeral < mark17/examples/max17-environment-observation.json",
    "max17:growth": "python3 mark17/growth_smoke.py",
    "max17:selfgrow": "python3 mark17/synapse_growth_smoke.py",
    "max17:ann": "python3 mark17/ann_smoke.py",
    "max17:bridge": "python3 mark17/bridge_smoke.py",
    "max17:voicestate": "python3 mark17/voice_smoke.py",
    "max17:semantic": "python3 mark17/semantic_smoke.py",
    "max17:tree": "python3 mark17/meaning_tree_smoke.py",
    "max17:ultra": "python3 mark17/ultra_smoke.py",
    "max17:music": "python3 mark17/music_smoke.py",
    "max17:codemem": "python3 mark17/code_memory_smoke.py",
    "max17:concepts": "python3 mark17/concepts_smoke.py",
    "max17:stats": "python3 mark17/json_cli.py --no-llm < mark17/examples/max17-graph-stats.json",
    "max17:compress": "python3 mark17/json_cli.py --no-llm --ephemeral < mark17/examples/max17-compress-memory.json",
    "max17:ultimate": "python3 mark17/ultimate_smoke.py",
    "max17:neural": "python3 mark17/json_cli.py --no-llm < mark17/examples/max17-neural-seed.json",
    "max17:walk": "python3 mark17/json_cli.py --no-llm < mark17/examples/max17-neural-walk.json",
    "clean": "next clean"
  },
  "dependencies": {
    "@google/genai": "^1.17.0",
    "@hookform/resolvers": "^5.2.1",
    "@vladmandic/face-api": "^1.7.15",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "firebase": "^12.10.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.3.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
