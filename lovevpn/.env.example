# Love VPN — пример настроек. Скопируйте в lovevpn/.env и заполните.
# Файл .env в git не попадает (см. .gitignore), .env.example — попадает.

# --- обязательное ---------------------------------------------------------

# Токен от @BotFather. ЭТО ПАРОЛЬ ОТ БОТА: никому не показывайте,
# не вставляйте в чаты и не коммитьте. Если утёк — /revoke в @BotFather.
BOT_TOKEN=

# Ваш Telegram ID (узнать: напишите @userinfobot). Через запятую, если админов
# несколько. Без этого админские команды недоступны никому.
LOVEVPN_ADMIN_IDS=

# --- необязательное -------------------------------------------------------

# Юзернейм бота без @ — используется в реферальных ссылках.
LOVEVPN_BOT_USERNAME=lovemevpn_bot

# Контакт поддержки, который бот показывает пользователям (@username или ссылка).
LOVEVPN_SUPPORT=

# Где лежит база и файл с конфигами. По умолчанию — рядом с ботом.
# LOVEVPN_DB_PATH=/var/lib/lovevpn/lovevpn.db
# LOVEVPN_CONFIGS_FILE=/var/lib/lovevpn/configs.txt

# Пробный период в днях (0 — выключить).
LOVEVPN_TRIAL_DAYS=3

# Бонус за друга: столько дней получают оба после первой оплаты приглашённого.
LOVEVPN_REFERRAL_BONUS_DAYS=30

# За сколько дней до конца подписки напоминать (команда /remind).
LOVEVPN_EXPIRY_WARN_DAYS=3

# Цены в звёздах Telegram. Рублёвые цены (199/555/999) зашиты в bot/config.py,
# а звёзды задаются здесь: курс звезды к рублю не фиксирован, сверьтесь
# с актуальным перед запуском продаж.
LOVEVPN_STARS_M1=120
LOVEVPN_STARS_M6=330
LOVEVPN_STARS_M12=600
