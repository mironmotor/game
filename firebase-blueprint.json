{
  "entities": {
    "userProfile": {
      "title": "User Profile",
      "description": "Stores the user's game progress and history",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "totalXp": { "type": "integer", "description": "Total XP earned" },
        "rank": { "type": "integer", "description": "Current rank" },
        "lastLaunch": { "type": "string", "description": "Date of last daily launch" },
        "dailyHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": "string" },
              "xp": { "type": "integer" }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "totalXp", "rank"]
    },
    "task": {
      "title": "Task",
      "description": "A gamified quest task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string", "description": "Owner UID" },
        "desc": { "type": "string" },
        "mgr": { "type": "string", "enum": ["MGR-1", "MGR-2", "MGR-3"] },
        "xp": { "type": "integer" },
        "status": { "type": "string", "enum": ["pending", "active", "completed", "failed"] },
        "aiAgentEnabled": { "type": "boolean", "description": "Whether this task can be executed by AI" },
        "aiAgentStatus": { "type": "string", "enum": ["idle", "running", "completed", "failed"] },
        "aiAgentResult": { "type": "string", "description": "The result of AI execution" },
        "aiAgentPlan": { "type": "string", "description": "The plan generated by AI" },
        "scheduledTime": { "type": "string" },
        "deadline": { "type": "string", "description": "ISO date string for task deadline" },
        "failureHandled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "desc", "mgr", "xp", "status"]
    },
    "message": {
      "title": "Message",
      "description": "A chat message for AI memory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "role", "content", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "User profile data"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "task",
      "description": "User's individual tasks"
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": "message",
      "description": "Chat history for AI context"
    }
  }
}
